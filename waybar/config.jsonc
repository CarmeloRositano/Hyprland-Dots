{
  // ======================================================
  // BAR SETTINGS
  // ======================================================
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,

  // ======================================================
  // MODULE PLACEMENT
  // ======================================================
  "modules-left": [
    "custom/blank",
    "custom/workspaces",
    "custom/blank",
		"custom/music",
		"custom/blank" 
 ],

  "modules-center": [
		"clock",
		"custom/blank",
		"custom/updates"
	],

  "modules-right": [
		"custom/wiremix",
    "custom/blank",
		"custom/network",
    "custom/blank",
		"custom/bluetooth",
		"custom/blank",
		"custom/btop",
		"custom/power",
  ],

  // ======================================================
  // MODULES
  // ======================================================

  "custom/workspaces": {
    "exec": "~/.config/waybar/workspaces.sh",
    "interval": 0,
    "return-type": "json",
  },	

  "custom/blank": {
    "format": " "
  },

  "clock": {
		"interval": 1,
    "format": "[{:%I:%M:%S %p}]",
    "format-alt": "[{:%e %B %A}]",
  },

	"custom/music": {
    "format": "{}",
    "return-type": "json",
    "exec": "waybar-module-music",
  },

	"custom/btop": {
		"format": "",
  	"on-click": "kitty --class btop --override remember_window_size=no --override initial_window_width=180c --override initial_window_height=50c -e btop"
	},

	"custom/updates": {
    "exec": "sh -c 'n=$(checkupdates 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && echo \"●\" || echo \" \"'",
  	"interval": 3600,
  	"format": "{}",
		"on-click": "kitty --class updates --title 'updates' --override remember_window_size=no --override initial_window_width=100c --override initial_window_height=30c -e ~/.config/waybar/pentagon-update.sh"
	},

	"custom/bluetooth": {
  	"format": "󰂯",
  	"on-click": "kitty --class bluetui --override remember_window_size=no --override initial_window_width=100c --override initial_window_height=30c -e bluetui"
	},

	"custom/network": {
		"format": "󰤨",
		"on-click": "kitty --class impala --override remember_window_size=no --override initial_window_width=100c --override initial_window_height=30c -e impala"
	},

	"custom/wiremix": {
    "format": "󰕾",
    "on-click": "kitty --class wiremix --override remember_window_size=no --override initial_window_width=900 --override initial_window_height=600 wiremix"
	},

	"custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/waybar/power-menu.sh"
	},
}
