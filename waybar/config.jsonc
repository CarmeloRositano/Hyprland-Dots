{
  // ======================================================
  // BAR SETTINGS
  // ======================================================
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,

  // ======================================================
  // MODULE PLACEMENT
  // ======================================================
  "modules-left": [
    "custom/blank",
    "custom/workspaces",
    "custom/blank",
  ],

  "modules-center": [
		"clock",
		"custom/updates"
	],

  "modules-right": [
		"custom/bluetooth",
		"custom/blank",
		"custom/btop",
  ],

  // ======================================================
  // MODULES
  // ======================================================

  "custom/workspaces": {
    "exec": "~/.config/waybar/workspaces.sh",
    "interval": 0,
    "return-type": "json",
    "on-scroll-up": "~/.config/waybar/workspaces.sh up",
    "on-scroll-down": "~/.config/waybar/workspaces.sh down"
  },

  "custom/blank": {
    "format": " "
  },

  "clock": {
		"interval": 1,
    "format": "[{:%I:%M:%S %p}]",
    "format-alt": "[{:%e %B %A}]"
  },

	"custom/btop": {
		"format": "",
  	"on-click": "kitty --class btop -e btop"
	},

	"custom/updates": {
  	"exec": "sh -c 'n=$(checkupdates 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && echo \"●\" || echo \"\"'",
  	"interval": 3600,
  	"on-click": "kitty --class updates -e sudo pacman -Syu"
	},

	"custom/bluetooth": {
  	"format": "󰂯",
  	"on-click": "kitty --class bluetui -e bluetui"
	},

}
?
